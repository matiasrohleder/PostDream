# Copy this file to .env and adjust the values.

# --- Initial admin user (only used when the database is empty) ---
ADMIN_EMAIL=admin@postdream.local
# Leave empty to generate a random password that is printed in the logs.
ADMIN_PASSWORD=change-me-please

# --- Ports published on the host ---
SMTP_PORT=1025
HTTP_PORT=8025
POP3_PORT=1110

# --- SMTP ---
# off      = AUTH is not offered, everything lands in the default inbox
# optional = AUTH routes to the matching inbox; anonymous mail lands in the default inbox (great locally)
# required = anonymous mail is rejected (recommended when exposed to the internet)
SMTP_AUTH=optional
SMTP_MAX_MESSAGE_BYTES=26214400
# Fixed SMTP password for the "default" inbox (empty = generated)
DEFAULT_INBOX_SMTP_PASSWORD=
# Optional STARTTLS (paths inside the container; mount the files with a volume)
SMTP_TLS_CERT=
SMTP_TLS_KEY=
# true = reject mail until the client uses STARTTLS (needs the cert above)
SMTP_REQUIRE_TLS=false
# Global regex every recipient must match (empty = all), e.g. @(acme\.test|example\.org)$
SMTP_ALLOWED_RECIPIENTS=
# POP3 listen address inside the container (empty = disabled)
POP3_ADDR=:1110

# --- UI ---
# false = the UI does not require login (only for 100% local use)
AUTH_ENABLED=true
# true when the UI is served over HTTPS (behind a proxy)
COOKIE_SECURE=false
# true when a reverse proxy sets X-Forwarded-For
TRUST_PROXY=false
SESSION_TTL=168h
# Comma-separated Host headers accepted by the UI/API (empty = any). Protects against DNS rebinding.
ALLOWED_HOSTS=
# Public base URL, used for links in webhook payloads (e.g. https://mail.example.com)
PUBLIC_URL=

# --- Retention ---
RETENTION_HOURS=72
RETENTION_INTERVAL=10m
# 0 = no per-inbox count limit
MAX_MESSAGES_PER_INBOX=0

# --- Database ---
POSTGRES_PASSWORD=postdream

# --- Webhooks & link check (outbound requests) ---
# Private networks are blocked unless allowed here or per inbox ("Allowed internal hosts").
OUTBOUND_ALLOW_PRIVATE=false
OUTBOUND_ALLOWED_HOSTS=
JOB_WORKERS=4

# --- Spam scoring (optional) ---
# Rspamd: docker compose --profile spam up -d  and  RSPAMD_URL=http://rspamd:11333
RSPAMD_URL=
RSPAMD_PASSWORD=
# Or SpamAssassin's spamd (host:port)
SPAMASSASSIN_ADDR=

# --- Releasing emails to real recipients (off when empty) ---
# smtp://user:pass@smtp.example.com:587  |  smtps://...:465  |  smtp://host:25?tls=none
RELAY_SMTP_URL=
RELAY_FROM=

# --- Prometheus metrics ---
# /metrics on the HTTP port behind "Authorization: Bearer <token>"
METRICS_TOKEN=
# or a separate unauthenticated listener inside the container, e.g. :9090
METRICS_ADDR=
